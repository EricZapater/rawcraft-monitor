# =============================================================================
# RAWCRAFT MONITOR - Backend Environment Variables (.env.backend)
# =============================================================================

# PostgreSQL Configuration (connects to existing PostgreSQL in postgres-network)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rawcraft_monitor
DB_SSLMODE=disable

# API Configuration
PORT=8080
APP_ENV=production
GIN_MODE=release
CENTRAL_PUBLIC_URL=https://api.monitor.ericzapater.cat

# JWT Security
JWT_SECRET=super_secret_jwt_key_replace_in_production_min_32_chars

# CORS & Base URLs
CORS_ORIGIN=https://monitor.ericzapater.cat

# Initial Admin Seed (HU-USR-01)
ADMIN_INITIAL_EMAIL=admin@monitor.ericzapater.cat
ADMIN_INITIAL_PASSWORD=AdminMonitor2026!
ADMIN_INITIAL_NAME=Administrador Rawcraft

# Global SMTP Defaults (Optional, used when server config has use_global_smtp=true)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=alerts@example.com

# Timezone
TZ=Europe/Madrid
