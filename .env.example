# Configuració General de Desenvolupament Local
APP_ENV=development
PORT=8080
CENTRAL_PUBLIC_URL=http://localhost:8080

# Base de Dades PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rawcraft_monitor
DB_SSLMODE=disable

# Seguretat i Tokens JWT
JWT_SECRET=dev-secret-jwt-key-2026-canvia-en-produccio
CORS_ORIGIN=http://localhost:5173

# Usuari Administrador Inicial (Creat automàticament en la primera arrencada)
ADMIN_INITIAL_EMAIL=admin@rawcraft.local
ADMIN_INITIAL_PASSWORD=Admin1234!
ADMIN_INITIAL_NAME=Administrador Rawcraft

# Configuració SMTP Global (Opcional en local)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@rawcraft.local
